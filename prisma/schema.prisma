generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  password      String
  name          String?
  savedColleges SavedCollege[]
  createdAt     DateTime      @default(now())
}

model College {
  id           String        @id @default(cuid())
  name         String
  location     String
  state        String
  fees         Int
  rating       Float
  courses      String[]
  placements   Int
  established  Int
  description  String
  savedBy      SavedCollege[]
}

model SavedCollege {
  id        String   @id @default(cuid())
  userId    String
  collegeId String
  user      User     @relation(fields: [userId], references: [id])
  college   College  @relation(fields: [collegeId], references: [id])
  @@unique([userId, collegeId])
}